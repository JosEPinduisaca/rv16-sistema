PORT=4000

DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rv16_sistema

JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# Para el correo de "Olvidé mi contraseña". Si dejas esto vacío, el enlace
# de recuperación simplemente se imprime en la consola del backend (útil
# para probar en desarrollo sin credenciales reales).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RV16 Núcleo Arbitral <no-responder@rv16.com>

# URL donde corre el frontend, para armar el enlace de recuperación
FRONTEND_URL=http://localhost:5173
